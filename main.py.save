@app.post("/add-package")
def add_package(name: str = Form(...), price: int = Form(...), uptime: str = Form(...), data_limit: str = Form(...)):

    db = SessionLocal()

    package = Package(
        name=name,
        price=price,
        uptime=uptime,
        data_limit=data_limit
    )

    db.add(package)
    db.commit()
    db.close()

    return RedirectResponse("/packages", status_code=303)


# ================= AUTH =================
@app.get("/login")
def login_page(request: Request):
    return templates.TemplateResponse(request=request, name="login.html", context={})


@app.post("/login")
def login(request: Request, username: str = Form(...), password: str = Form(...)):

    db = SessionLocal()

    user = db.query(User).filter(User.username == username, User.password == password).first()

    db.close()

    if not user:
        return {"error": "Invalid login"}

    request.session["user"] = user.username
    return RedirectResponse("/dashboard", status_code=303)


@app.get("/logout")
def logout(request: Request):
    request.session.clear()
    return RedirectResponse("/login", status_code=303)
@app.get("/voucher-list")
def voucher_list(request: Request):
    db = SessionLocal()
    vouchers = db.query(Voucher).all()
    db.close()

    return templates.TemplateResponse(
        request=request,
        name="vouchers.html",
        context={"vouchers": vouchers}
    )
@app.get("/voucher-list")
def voucher_list(request: Request, search: str = ""):

    db = SessionLocal()

    if search:
        vouchers = db.query(Voucher).filter(
            Voucher.code.contains(search)
        ).all()
    else:
        vouchers = db.query(Voucher).all()

    db.close()

    return templates.TemplateResponse(
        request=request,
        name="vouchers.html",
        context={
            "vouchers": vouchers,
            "search": search
        }
    )
