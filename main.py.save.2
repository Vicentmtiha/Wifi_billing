        "used_vouchers": len(used_vouchers),
        "unused_vouchers": len(unused_vouchers),
        "total_revenue": total_revenue,
        "router_status": mikrotik_status
    }
    return templates.TemplateResponse(
        request=request,
        name="dashboard.html",
        context=data
    )


