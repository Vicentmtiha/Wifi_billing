@app.post("/hotspot-login")
def hotspot_login(voucher: str = Form(...), mac: str = Form(...)):
    """Handle hotspot voucher login"""
    voucher_obj = VoucherService.get_voucher_by_code(voucher)
    
    if not voucher_obj:
        return {"status": "error", "message": "Voucher haipo"}
    
    if voucher_obj.status != "unused":
        return {"status": "error", "message": "Voucher tayari imetumika"}
    
    # Check expiry
    if voucher_obj.expires_at < datetime.now():
        return {"status": "error", "message": "Voucher imekaliwa muda"}
    
    # Mark as used
    success = VoucherService.mark_used(voucher_obj.id, mac)
    if not success:
        return {"status": "error", "message": "Kosa katika kuboresha voucher"}
    
    # Lock to MAC asynchronously
    if MikrotikConfig.ENABLED:
        threading.Thread(
            target=MikrotikService.lock_voucher_to_mac,
            args=(voucher, mac),
            daemon=True
        ).start()
    
    logger.info(f"Voucher {voucher} used with MAC {mac}")
    return {"status": "success", "message": "Karibu kwenye network!"}


