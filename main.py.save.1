# ================= DASHBOARD =================
@app.get("/dashboard")
def dashboard(request: Request):
    check = login_required(request)
    if check: return check
    db = SessionLocal()
    try:
        now = datetime.now()
        data = {
            "request": request,
            "total": db.query(Voucher).count(),
            "used": db.query(Voucher).filter(Voucher.status == "used").count(),
            "unused": db.query(Voucher).filter(Voucher.status == "unused", Voucher.expires_at > now).count(),
            "expired": db.query(Voucher).filter((Voucher.status == "expired") | (Voucher.expires_at < now)).count(),
            "recent": db.query(Voucher).order_by(Voucher.id.desc()).limit(5).all(),
            "packages": db.query(Package).all(),
            "user": current_user(request)
        }
        return templates.TemplateResponse(request=request, name="dashboard.html", context=data)
    finally:
        db.close()

