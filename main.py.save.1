# ================= HELPER FUNCTIONS =================
def convert_to_mikrotik_time(time_str):
    time_str = time_str.lower().strip()
    num = int(re.search(r'\d+', time_str).group()) if re.search(r'\d+', time_str) else 1
    if 'day' in time_str:
        return f"{num * 24:02}:00:00"
    elif 'h' in time_str:
        return f"{num:02}:00:00"
    elif 'm' in time_str:
        return f"00:{num:02}:00"
    return "01:00:00"

def get_api():
    return connect(host=MIKROTIK_HOST, username=MIKROTIK_USER, password=MIKROTIK_PASS, port=MIKROTIK_PORT)

def lock_voucher_to_mac(voucher_code, client_mac):
    try:
        api = get_api()
        api.path("/ip/hotspot/user").set(name=voucher_code, mac_address=client_mac)
    except Exception as e:
        logging.error(f"MAC Binding Error: {e}")

def generate_code():
    return ''.join(random.choices(string.ascii_uppercase + string.digits, k=6))

def current_user(request: Request):
    return request.session.get("user", "Guest")

def login_required(request: Request):
    if not request.session.get("logged_in"):
        return RedirectResponse("/login")
    return None

def add_voucher_to_db(price=500, uptime="1h", data_limit="1GB", profile_name="default"):
    db = SessionLocal()
    try:
        code = generate_code()
        expiry_date = datetime.now() + timedelta(days=30)
        voucher = Voucher(code=code, profile=profile_name, price=price, uptime=uptime,
                          data_limit=data_limit, status="unused", created_at=datetime.now(),
                          expires_at=expiry_date, used_by="")
        db.add(voucher)
        db.commit()
        try:
            api = get_api()
            mikrotik_uptime = convert_to_mikrotik_time(uptime)
            user_data = {
                "name": code, 
                "password": code, 
                "limit-uptime": mikrotik_uptime, 
                "comment": "Manual Voucher"
            }
            api.path("/ip/hotspot/user").add(**user_data)
        except Exception as e:
            logging.error(f"Mikrotik Error: {e}")
        return code
    finally:
        db.close()

def check_expiry():
    db = SessionLocal()
    try:
        now = datetime.now()
        vouchers = db.query(Voucher).filter(Voucher.status == "unused", Voucher.expires_at < now).all()
        if vouchers:
            try:
                api = get_api()
                for v in vouchers:
                    try:
                        api.path("/ip/hotspot/user").remove(name=v.code)
                    except: pass
                    v.status = "expired"
                db.commit()
            except Exception as e:
                logging.error(f"Mikrotik connection error in check_expiry: {e}")
    finally:
        db.close()

def worker():
    while True:
        check_expiry()
        time.sleep(300)

threading.Thread(target=worker, daemon=True).start()

