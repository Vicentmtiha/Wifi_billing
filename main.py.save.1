@app.post("/hotspot-login")
def hotspot_login(voucher: str = Form(...), mac: str = Form(...)):
    db = SessionLocal()
    try:
        v = db.query(Voucher).filter(Voucher.code == voucher, Voucher.status == "unused").first()
        if v:
            lock_voucher_to_mac(voucher, mac)
            v.status = "used"
            db.commit()
